GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
# Em produção (NODE_ENV=production) as chaves acima são IGNORADAS: qualquer visitante do site
# gastaria a sua cota. Defina 1 só se o deploy for privado (ex.: atrás de login).
MESA_ALLOW_ENV_KEYS=
# Debate rápido: com NVIDIA_API_KEY definida, a home mostra o campo de tema e o servidor usa essa chave
# só nesse modo (mesa e modelo fixos, com limite de uso), mesmo em produção.
# Opcional: fixa o modelo; vazio = o melhor Nemotron do catálogo.
MESA_QUICK_MODEL=
